{
  "name": "pi-action",
  "version": "0.5.1",
  "description": "github/gitea/forgejo action for running the pi harness",
  "license": "MIT",
  "repository": {
    "url": "https://trev.zip/llc/pi-action"
  },
  "bin": {
    "pi-action": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "vite build --configLoader runner",
    "dev": "vite build --configLoader runner && node build/index.js",
    "prepare": "vite build --configLoader runner && chmod +x build/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
